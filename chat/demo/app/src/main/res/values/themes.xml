<resources>
    <style name="demo_Theme_ChatView" parent="Chat_UIKit_Theme" />

    <style name="XingDunStartupTheme" parent="Theme.SplashScreen.IconBackground">
        <item name="android:windowBackground">@drawable/xingdun_starting_window</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="windowSplashScreenBackground">@color/xingdun_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/xingdun_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/xingdun_brand_navy</item>
        <item name="postSplashScreenTheme">@style/Chat_UIKit_Theme</item>
    </style>

    <style name="XingDunEnterpriseTrustItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">62dp</item>
        <item name="android:textColor">#536D68</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="XingDunAuthLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">#536A66</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="XingDunAuthInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/xingdun_bg_enterprise_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#123F3A</item>
        <item name="android:textColorHint">#A6B4B1</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="XingDunAuthSegmentButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/xingdun_bg_enterprise_segment</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#667D79</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="XingDunAuthLinkButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#179A84</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="XingDunMineStat">
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="XingDunDatePickerTheme">
        <item name="android:colorAccent">#23B39C</item>
        <item name="android:colorControlActivated">#23B39C</item>
    </style>
</resources>
