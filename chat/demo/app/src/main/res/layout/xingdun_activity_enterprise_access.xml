<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xingdun_bg_enterprise_access">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/xingdun_enterprise_access_eyebrow"
                android:textColor="#179A84"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/xingdun_bg_enterprise_logo_ring"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/demo_app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/xingdun_ic_enterprise_shield" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/xingdun_enterprise_verify_title"
                android:textColor="#123F3A"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/xingdun_enterprise_verify_subtitle"
                android:textColor="#667D79"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/xingdun_bg_enterprise_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xingdun_enterprise_lookup_method"
                    android:textColor="#61736F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/xingdun_bg_enterprise_segment_container"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <Button
                        android:id="@+id/xingdun_enterprise_code_mode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/xingdun_bg_enterprise_segment_selected"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="@string/xingdun_company_code"
                        android:textAllCaps="false"
                        android:textColor="#163E39"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/xingdun_enterprise_domain_mode"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/xingdun_bg_enterprise_segment"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="@string/xingdun_enterprise_domain_short"
                        android:textAllCaps="false"
                        android:textColor="#163E39"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/xingdun_enterprise_input_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="@string/xingdun_company_code"
                    android:textColor="#536A66"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/xingdun_enterprise_lookup_input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:autofillHints="organizationName"
                    android:background="@drawable/xingdun_bg_enterprise_input"
                    android:hint="@string/xingdun_enterprise_code_placeholder"
                    android:imeOptions="actionDone"
                    android:maxLength="255"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="#123F3A"
                    android:textColorHint="#9AABA8"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/xingdun_enterprise_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:minHeight="20dp"
                    android:textColor="#B3261E"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="9dp">

                    <Button
                        android:id="@+id/xingdun_enterprise_connect"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/xingdun_bg_enterprise_button"
                        android:minHeight="0dp"
                        android:text="@string/xingdun_enterprise_connect_service"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/xingdun_enterprise_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="22dp"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    style="@style/XingDunEnterpriseTrustItem"
                    android:drawableTop="@android:drawable/ic_lock_lock"
                    android:drawableTint="#1EAA91"
                    android:text="@string/xingdun_enterprise_trust_protection" />

                <TextView
                    style="@style/XingDunEnterpriseTrustItem"
                    android:drawableTop="@android:drawable/ic_menu_myplaces"
                    android:drawableTint="#1EAA91"
                    android:text="@string/xingdun_enterprise_trust_isolation" />

                <TextView
                    style="@style/XingDunEnterpriseTrustItem"
                    android:drawableTop="@android:drawable/ic_popup_sync"
                    android:drawableTint="#1EAA91"
                    android:text="@string/xingdun_enterprise_trust_sync" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/xingdun_enterprise_support_hint"
                android:textColor="#718581"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
