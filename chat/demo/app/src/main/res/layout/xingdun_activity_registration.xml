<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.trtc.tuikit.chat.demo.xingdun.launch.XingDunCircuitBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/xingdun_registration_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start"
                android:background="@drawable/xingdun_bg_auth_capsule"
                android:contentDescription="@string/xingdun_close_registration"
                android:gravity="center"
                android:text="@string/xingdun_close_symbol"
                android:textColor="#123F3A"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View android:layout_width="34dp" android:layout_height="1dp" android:background="#F4BD48" />
                <TextView
                    android:id="@+id/xingdun_registration_brand_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:text="@string/demo_app_name"
                    android:textColor="#179A84"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <View android:layout_width="34dp" android:layout_height="1dp" android:background="#F4BD48" />
            </LinearLayout>

            <io.trtc.tuikit.chat.demo.xingdun.launch.XingDunEnterpriseLogoView
                android:id="@+id/xingdun_registration_logo"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/xingdun_registration_title"
                android:textColor="#123F3A"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/xingdun_registration_subtitle"
                android:textColor="#667D79"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/xingdun_registration_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:minHeight="20dp"
                android:textColor="#B3261E"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/xingdun_bg_enterprise_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/xingdun_bg_enterprise_segment_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <Button
                        android:id="@+id/xingdun_registration_account_tab"
                        style="@style/XingDunAuthSegmentButton"
                        android:text="@string/xingdun_account_registration" />
                    <Button
                        android:id="@+id/xingdun_registration_phone_tab"
                        style="@style/XingDunAuthSegmentButton"
                        android:text="@string/xingdun_phone_registration" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/xingdun_registration_account_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_username" />
                    <EditText
                        android:id="@+id/xingdun_registration_username"
                        style="@style/XingDunAuthInput"
                        android:autofillHints="newUsername"
                        android:hint="@string/xingdun_registration_username_placeholder"
                        android:inputType="textNoSuggestions"
                        android:maxLength="20" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/xingdun_registration_phone_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_phone" />
                    <EditText
                        android:id="@+id/xingdun_registration_phone"
                        style="@style/XingDunAuthInput"
                        android:autofillHints="phone"
                        android:hint="@string/xingdun_phone_placeholder"
                        android:inputType="phone"
                        android:maxLength="11" />
                    <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_verification_code" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/xingdun_registration_code"
                            style="@style/XingDunAuthInput"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginTop="0dp"
                            android:layout_weight="1"
                            android:autofillHints="smsOTPCode"
                            android:hint="@string/xingdun_code_placeholder"
                            android:inputType="number"
                            android:maxLength="6" />
                        <Button
                            android:id="@+id/xingdun_registration_get_code"
                            android:layout_width="122dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/xingdun_bg_auth_capsule"
                            android:text="@string/xingdun_get_verification_code"
                            android:textAllCaps="false"
                            android:textColor="#179A84"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_optional_nickname" />
                <EditText
                    android:id="@+id/xingdun_registration_nickname"
                    style="@style/XingDunAuthInput"
                    android:autofillHints="name"
                    android:hint="@string/xingdun_nickname_placeholder"
                    android:inputType="textPersonName"
                    android:maxLength="64" />

                <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_set_password" />
                <EditText
                    android:id="@+id/xingdun_registration_password"
                    style="@style/XingDunAuthInput"
                    android:autofillHints="newPassword"
                    android:hint="@string/xingdun_password_placeholder"
                    android:inputType="textPassword" />

                <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_confirm_password" />
                <EditText
                    android:id="@+id/xingdun_registration_confirm_password"
                    style="@style/XingDunAuthInput"
                    android:autofillHints="newPassword"
                    android:hint="@string/xingdun_confirm_password_placeholder"
                    android:inputType="textPassword" />

                <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_invite_code" />
                <EditText
                    android:id="@+id/xingdun_registration_invite_code"
                    style="@style/XingDunAuthInput"
                    android:hint="@string/xingdun_invite_code_placeholder"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:maxLength="20" />
                <Button
                    android:id="@+id/xingdun_registration_scan_invite"
                    style="@style/XingDunAuthLinkButton"
                    android:layout_gravity="end"
                    android:text="@string/xingdun_scan_invitation" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal">
                    <CheckBox
                        android:id="@+id/xingdun_registration_consent"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:buttonTint="#1EAA91"
                        android:contentDescription="@string/xingdun_privacy_consent_accessibility"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp" />
                    <TextView
                        android:id="@+id/xingdun_registration_agreement_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text="@string/xingdun_privacy_consent"
                        android:textColor="#667D79"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/xingdun_registration_primary_action"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/xingdun_bg_auth_primary"
                    android:clickable="true"
                    android:contentDescription="@string/xingdun_create_account"
                    android:focusable="true"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/xingdun_registration_primary_action_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xingdun_create_account"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/xingdun_registration_back_login"
                style="@style/XingDunAuthLinkButton"
                android:layout_marginTop="12dp"
                android:text="@string/xingdun_back_to_login" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
