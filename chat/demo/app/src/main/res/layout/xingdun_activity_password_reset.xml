<?xml version='1.0' encoding='utf-8'?>
<io.trtc.tuikit.chat.demo.xingdun.launch.TravelAuthLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" app:authScene="2" app:authTitle="@string/xingdun_password_reset_title" app:authSubtitle="@string/ta_reset_subtitle">
