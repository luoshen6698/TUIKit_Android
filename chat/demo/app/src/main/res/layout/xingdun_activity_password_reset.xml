<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.trtc.tuikit.chat.demo.xingdun.launch.XingDunCircuitBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/xingdun_password_reset_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start"
                android:background="@drawable/xingdun_bg_auth_capsule"
                android:contentDescription="@string/xingdun_close_password_reset"
                android:gravity="center"
                android:text="@string/xingdun_close_symbol"
                android:textColor="#123F3A"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <View android:layout_width="34dp" android:layout_height="1dp" android:background="#F4BD48" />
                <TextView
                    android:id="@+id/xingdun_password_reset_brand_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:text="@string/demo_app_name"
                    android:textColor="#179A84"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <View android:layout_width="34dp" android:layout_height="1dp" android:background="#F4BD48" />
            </LinearLayout>

            <io.trtc.tuikit.chat.demo.xingdun.launch.XingDunEnterpriseLogoView
                android:id="@+id/xingdun_password_reset_logo"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/xingdun_password_reset_title"
                android:textColor="#123F3A"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/xingdun_password_reset_subtitle"
                android:textColor="#667D79"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/xingdun_password_reset_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:minHeight="20dp"
                android:textColor="#B3261E"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/xingdun_password_reset_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/xingdun_bg_enterprise_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/xingdun_bg_enterprise_segment_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp">
                    <Button
                        android:id="@+id/xingdun_password_reset_phone_tab"
                        style="@style/XingDunAuthSegmentButton"
                        android:text="@string/xingdun_phone" />
                    <Button
                        android:id="@+id/xingdun_password_reset_email_tab"
                        style="@style/XingDunAuthSegmentButton"
                        android:text="@string/xingdun_email" />
                </LinearLayout>

                <TextView
                    android:id="@+id/xingdun_password_reset_target_label"
                    style="@style/XingDunAuthLabel"
                    android:text="@string/xingdun_phone" />
                <EditText
                    android:id="@+id/xingdun_password_reset_target"
                    style="@style/XingDunAuthInput"
                    android:autofillHints="phone"
                    android:hint="@string/xingdun_bound_phone_placeholder"
                    android:inputType="phone"
                    tools:ignore="TextFields" />

                <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_verification_code" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/xingdun_password_reset_code"
                        style="@style/XingDunAuthInput"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:autofillHints="smsOTPCode"
                    android:hint="@string/xingdun_code_placeholder"
                    android:inputType="number"
                    android:maxLength="6"
                    tools:ignore="TextFields" />
                    <Button
                        android:id="@+id/xingdun_password_reset_get_code"
                        android:layout_width="122dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/xingdun_bg_auth_capsule"
                        android:text="@string/xingdun_get_verification_code"
                        android:textAllCaps="false"
                        android:textColor="#179A84"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_new_password" />
                <EditText
                    android:id="@+id/xingdun_password_reset_new_password"
                    style="@style/XingDunAuthInput"
                    android:autofillHints="newPassword"
                    android:hint="@string/xingdun_new_password_placeholder"
                    android:inputType="textPassword" />

                <TextView style="@style/XingDunAuthLabel" android:text="@string/xingdun_confirm_new_password" />
                <EditText
                    android:id="@+id/xingdun_password_reset_confirm_password"
                    style="@style/XingDunAuthInput"
                    android:autofillHints="newPassword"
                    android:hint="@string/xingdun_confirm_new_password_placeholder"
                    android:inputType="textPassword" />

                <LinearLayout
                    android:id="@+id/xingdun_password_reset_primary_action"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/xingdun_bg_auth_primary"
                    android:clickable="true"
                    android:contentDescription="@string/xingdun_confirm_reset"
                    android:focusable="true"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xingdun_confirm_reset"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/xingdun_password_reset_completion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/xingdun_bg_enterprise_card"
                android:elevation="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:text="@string/xingdun_success_symbol"
                    android:textColor="#1EAA91"
                    android:textSize="54sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xingdun_password_reset_success_title"
                    android:textColor="#123F3A"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/xingdun_password_reset_success_subtitle"
                    android:textColor="#667D79"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/xingdun_password_reset_back_login"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/xingdun_bg_auth_primary"
                    android:text="@string/xingdun_back_to_login"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
