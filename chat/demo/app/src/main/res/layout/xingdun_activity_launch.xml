<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xingdun_launch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="72dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/demo_app_name"
            android:src="@drawable/demo_ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/demo_app_name"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/xingdun_launch_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="24dp"
            android:textColor="#B3261E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/xingdun_selected_enterprise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#536A66"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/xingdun_switch_enterprise"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="@string/xingdun_switch_enterprise"
            android:textAllCaps="false" />

        <EditText
            android:id="@+id/xingdun_company_code"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:autofillHints="organizationName"
            android:hint="@string/xingdun_company_code"
            android:imeOptions="actionNext"
            android:inputType="textNoSuggestions"
            android:maxLength="20"
            android:singleLine="true"
            android:visibility="gone" />

        <EditText
            android:id="@+id/xingdun_username"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:autofillHints="username"
            android:hint="@string/xingdun_account"
            android:imeOptions="actionNext"
            android:inputType="textNoSuggestions"
            android:singleLine="true" />

        <EditText
            android:id="@+id/xingdun_nickname"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="@string/xingdun_nickname"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:visibility="gone" />

        <EditText
            android:id="@+id/xingdun_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:hint="@string/xingdun_password"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/xingdun_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:hint="@string/xingdun_confirm_password"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:singleLine="true"
            android:visibility="gone" />

        <EditText
            android:id="@+id/xingdun_invite_code"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="@string/xingdun_invite_code"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:maxLength="20"
            android:singleLine="true"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/xingdun_adult_declaration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/xingdun_adult_declaration"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/xingdun_privacy_consent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xingdun_privacy_consent" />

        <LinearLayout
            android:id="@+id/xingdun_legal_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/xingdun_user_agreement"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/xingdun_user_agreement"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/xingdun_privacy_policy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/xingdun_privacy_policy"
                android:textAllCaps="false" />
        </LinearLayout>

        <Button
            android:id="@+id/xingdun_primary_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/xingdun_login"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/xingdun_switch_mode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/xingdun_create_account"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/xingdun_language"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/demo_settings_language"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
