<?xml version='1.0' encoding='utf-8'?>
<io.trtc.tuikit.chat.demo.xingdun.launch.TravelAuthLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" app:authScene="0" app:authTitle="@string/xingdun_welcome_back" app:authSubtitle="@string/ta_login_subtitle">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/xingdun_login_panel">
        <io.trtc.tuikit.chat.demo.xingdun.launch.TravelAuthStatusView android:id="@+id/xingdun_launch_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ta_ready" android:textSize="12sp" android:textColor="#405E56" android:visibility="visible" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/xingdun_deletion_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ta_ready" android:textSize="12sp" android:textColor="#405E56" android:visibility="gone" android:layout_marginTop="6dp" />
        <Button android:id="@+id/travel_auth_retry" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/xingdun_retry" android:textSize="12sp" android:textAllCaps="false" android:textColor="#2F6055" android:background="@android:color/transparent" android:paddingStart="8dp" android:paddingEnd="8dp" android:minWidth="48dp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/travel_company_group">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:hint="@string/ta_code_prompt" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxBackgroundColor="#80FFFFFF" app:boxStrokeColor="@color/travel_auth_outline" app:hintTextColor="#405E56" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="1.5dp" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@drawable/travel_auth_company" app:startIconTint="#405E56">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/xingdun_company_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:textSize="12sp" android:textColor="#203B37" android:singleLine="true" android:inputType="text" android:imeOptions="actionNext" android:paddingTop="14dp" android:paddingBottom="14dp" android:focusable="false" android:cursorVisible="false" android:paddingEnd="76dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <Button android:id="@+id/xingdun_switch_enterprise" android:layout_width="72dp" android:layout_height="48dp" android:text="@string/ta_switch" android:textSize="12sp" android:textAllCaps="false" android:textColor="#2F6055" android:background="@android:color/transparent" android:paddingStart="8dp" android:paddingEnd="8dp" android:minWidth="48dp" android:layout_gravity="end|center_vertical" android:layout_marginBottom="10dp" />
            </FrameLayout>
            <TextView android:id="@+id/xingdun_selected_enterprise" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ta_code_required" android:textSize="12sp" android:textColor="#405E56" android:visibility="visible" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:hint="@string/xingdun_username" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxBackgroundColor="#80FFFFFF" app:boxStrokeColor="@color/travel_auth_outline" app:hintTextColor="#405E56" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="1.5dp" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@drawable/travel_auth_user" app:startIconTint="#405E56">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/xingdun_username" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:textSize="12sp" android:textColor="#203B37" android:singleLine="true" android:inputType="text" android:imeOptions="actionNext" android:paddingTop="14dp" android:paddingBottom="14dp" android:maxLength="64" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:hint="@string/xingdun_password" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxBackgroundColor="#80FFFFFF" app:boxStrokeColor="@color/travel_auth_outline" app:hintTextColor="#405E56" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="1.5dp" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:startIconDrawable="@drawable/travel_auth_lock" app:startIconTint="#405E56" app:endIconMode="password_toggle" app:endIconTint="#405E56">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/xingdun_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:textSize="12sp" android:textColor="#203B37" android:singleLine="true" android:inputType="textPassword" android:imeOptions="actionNext" android:paddingTop="14dp" android:paddingBottom="14dp" android:maxLength="64" android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/xingdun_remember_login" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:text="@string/xingdun_remember_login" android:textSize="12sp" android:textColor="#2F6055" android:buttonTint="#2F6055" />
            <Button android:id="@+id/xingdun_forgot_password" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/xingdun_forgot_password" android:textSize="12sp" android:textAllCaps="false" android:textColor="#2F6055" android:background="@android:color/transparent" android:paddingStart="8dp" android:paddingEnd="8dp" android:minWidth="48dp" android:layout_gravity="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:layout_marginBottom="18dp">
            <CheckBox android:id="@+id/xingdun_privacy_consent" android:layout_width="40dp" android:layout_height="48dp" android:buttonTint="#2F6055" />
            <TextView android:id="@+id/xingdun_agreement_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#405E56" android:lineSpacingExtra="4dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/xingdun_primary_action" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/travel_auth_primary" android:clickable="true" android:focusable="true" android:layout_marginTop="4dp">
            <TextView android:id="@+id/xingdun_primary_action_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/xingdun_login" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" />
        </LinearLayout>
        <TextView android:id="@+id/xingdun_copyright" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/demo_app_name" android:textSize="12sp" android:textColor="#405E56" android:visibility="gone" android:layout_marginTop="6dp" android:gravity="center" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ta_no_account" android:textSize="12sp" android:textColor="#405E56" />
            <Button android:id="@+id/xingdun_switch_mode" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/ta_create_account" android:textSize="12sp" android:textAllCaps="false" android:textColor="#2F6055" android:background="@android:color/transparent" android:paddingStart="8dp" android:paddingEnd="8dp" android:minWidth="48dp" />
        </LinearLayout>
    </LinearLayout>
</io.trtc.tuikit.chat.demo.xingdun.launch.TravelAuthLayout>