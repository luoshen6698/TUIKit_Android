<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#A9DDD3" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#C6EEE5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#128B75" android:endColor="#28B99D" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#8DEBD7" />
        </shape>
    </item>
</selector>
